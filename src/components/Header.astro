---
import Button from './UI/Button.astro';

// Данные для меню
const menuItems = [
  { id: 'benefits', title: 'Услуги' },
  { id: 'calculation', title: 'Кейсы' },
  { id: 'process', title: 'Контакты' },
];
---

<header class="header">
  <div class="header__container">
    <!-- Логотип и основная навигация -->
    <div class="header__logo-nav">
      <!-- Бургер кнопка для мобильных -->
      <button class="header__burger" id="burger-button">
        <span class="header__burger-line"></span>
        <span class="header__burger-line"></span>
        <span class="header__burger-line"></span>
      </button>
      
      <!-- Логотип -->
      <a href="/" class="header__logo">
        <img src="/images/Logo.svg" alt="Логотип" />
      </a>

      <!-- Десктопное меню -->
      <nav class="header__desktop-nav">
        {menuItems.map(item => (
          <a 
            href={`#${item.id}`} 
            class="header__nav-link"
          >
            {item.title}
          </a>
        ))}
      </nav>
    </div>

    <!-- Контакты и социальные сети -->
    <div class="header__contacts">
      <a href="tel:88005553535" class="header__phone">8 800 555 35 35</a>
      <Button variant="secondary" hasBlur className="header__consult-btn open-form">ПОЛУЧИТЬ КОНСУЛЬТАЦИЮ</Button>
      
      <div class="header__social">
        <a href="#" class="header__social-link"> 
          <img src="/images/WP.svg" alt="WhatsApp" />
        </a>
        <a href="#" class="header__social-link">
          <img src="/images/Telegram.svg" alt="Telegram" />
        </a>
      </div>
    </div>
  </div>
  <!-- Мобильное меню -->
  <div class="header__mobile-menu header__mobile-menu--hidden" id="mobile-menu">
    <div class="header__mobile-header">
      <button class="header__mobile-close" id="close-menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M18 6L6 18M6 6L18 18" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      
      <a href="/" class="header__mobile-logo">
        <img src="/images/Logo.svg" alt="Логотип" />
      </a>
      
      <div class="header__mobile-social">
        <a href="#" class="header__social-link">
          <img src="/images/Telegram.svg" alt="Telegram" />
        </a>
        <a href="#" class="header__social-link"> 
          <img src="/images/WP.svg" alt="WhatsApp" />
        </a>
      </div>
    </div>
    
    <!-- Мобильная навигация -->
    <nav class="header__mobile-nav">
      {menuItems.map(item => (
        <a 
          href={`#${item.id}`} 
          class="header__mobile-nav-link"
          onclick="document.getElementById('mobile-menu').classList.add('header__mobile-menu--hidden')"
        >
          {item.title}
        </a>
      ))}
    </nav>
    
    <!-- Контакты в мобильном меню -->
    <div class="header__mobile-contacts">
      <a href="tel:88005553535" class="header__mobile-phone">8 800 555 35 35</a>
      <Button className="open-form" variant="primary">ПОЛУЧИТЬ КОНСУЛЬТАЦИЮ</Button>
    </div>
  </div>
</header>

<style lang="scss" is:global>
.header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: var(--z-fixed);
  padding: var(--space-6) var(--space-4);
  
  &__container {
    max-width: var(--container-max);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  &__logo-nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }
  
  &__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.125rem;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(4px);
    padding: var(--space-2);
    
    @media (max-width: 767px) {
      display: flex;
    }
  }
  
  &__burger-line {
    display: block;
    width: 20px;
    height: 2px;
    background-color: var(--color-white);
  }
  
  &__logo {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    
    img {
      height: 32px;
      width: auto;
    }
  }
  
  &__desktop-nav {
    display: none;
    
    @media (min-width: 768px) {
      display: flex;
      align-items: center;
      gap: var(--space-6);
      // background: rgba(255, 255, 255, 0.1);
      // backdrop-filter: blur(8px);
      // padding: var(--space-4) var(--space-8);
      // border-radius: var(--radius-xl);
    }
  }
  
  &__nav-link {
    font-size: var(--text-sm);
    color: var(--color-white);
    transition: color var(--transition-fast);
    
    &:hover {
      color: var(--color-secondary);
    }
  }
  
  &__contacts {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    
    @media (max-width: 767px) {
      gap: var(--space-2);
    }
  }
  
  &__phone {
    display: none;
    color: var(--color-white);
    
    @media (min-width: 768px) {
      display: inline-block;
    }
  }
  
  &__consult-btn {
    display: none !important;
    
    @media (min-width: 768px) {
      display: inline-flex !important;
    }
  }
  
  &__social {
    display: flex;
    gap: var(--space-2);
  }
  
  &__social-link {
    display: inline-flex;
    transition: opacity var(--transition-fast);
    
    &:hover {
      opacity: 0.8;
    }
    
    img {
      width: 36px;
      height: 36px;
    }
  }
  
  /* Мобильное меню */
  &__mobile-menu {
    position: fixed;
    top: -16px;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-dark);
    backdrop-filter: blur(4px);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    z-index: var(--z-modal);
    // border-radius: var(--radius-xl);
    // border: 1px solid rgba(255, 255, 255, 0.1);
    margin-top: var(--space-4);
    
    @media (min-width: 768px) {
      display: none !important;
    }
    
    &--hidden {
      display: none;
    }
  }
  
  &__mobile-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  &__mobile-close {
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-1);
    color: var(--color-white);
  }
  
  &__mobile-logo {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    
    img {
      height: 32px;
      width: auto;
    }
  }
  
  &__mobile-social {
    display: flex;
    gap: var(--space-2);
  }
  
  &__mobile-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    text-align: center;
    padding: var(--space-8) 0;
    margin-top: auto;
  }
  
  &__mobile-nav-link {
    font-size: var(--text-3xl);
    color: var(--color-white);
    transition: color var(--transition-fast);
    
    &:hover {
      color: var(--color-secondary);
    }
  }
  
  &__mobile-contacts {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-4);
    width: 100%;
    text-align: center;
    margin-top: auto;
    
  }
  
  &__mobile-phone {
    font-size: var(--text-3xl);
    color: var(--color-white);
    // margin-bottom: var(--space-4);
  }
}
</style>

<script>
  document.getElementById('burger-button').addEventListener('click', function() {
    const menu = document.getElementById('mobile-menu');
    menu.classList.toggle('header__mobile-menu--hidden');
  });

  document.getElementById('close-menu').addEventListener('click', function() {
    const menu = document.getElementById('mobile-menu');
    menu.classList.toggle('header__mobile-menu--hidden');
  });
</script>