---
import Button from './UI/Button.astro';

export interface Props {
  title: string;
  buttonText?: string;
  backgroundLeft?: string;
  backgroundRight?: string;
  className?: string;
}

const {
  title = 'Напишите нам',
  buttonText = 'ОТПРАВИТЬ',
  backgroundRight = '/images/form-bg_1.png',
  className = ''
} = Astro.props;
---

<section class={`contact-form-section ${className}`}>
  <div class="contact-form-container">
    <!-- Блок формы: занимает 9 колонок и 2 строки -->
    <div class="contact-form-main">
      <div class="contact-form-bg">
        <img 
          src={backgroundRight}
          alt="Фоновое изображение справа" 
          width="400"
          height="300"
          loading="lazy"
        />
      </div>
      <div class="contact-form-content">
        <h2 
          class="contact-form-title"
          set:html={title}
        ></h2>

        <form class="contact-form"> 
          <div class="contact-form-grid">
            <label class="contact-form-field">
              <span class="contact-form-label">Ваше имя</span>
              <input 
                class="contact-form-input"
                placeholder=""
              />
            </label>
            
            <label class="contact-form-field">
              <span class="contact-form-label">Номер телефона</span>
              <input 
                class="contact-form-input"
                placeholder=""
              />
            </label>
          </div>

          <label class="contact-form-field contact-form-field-textarea">
            <span class="contact-form-label">Расскажите о вашем проекте (необязательно)</span>
            <textarea 
              rows="5"
              class="contact-form-textarea"
              placeholder=""
            ></textarea>
          </label>

          <label class="contact-form-checkbox">
            <div class="contact-form-checkbox-box">
              <input 
                type="checkbox" 
                class="contact-form-checkbox-input"
                required
              />
            </div>
            <span class="contact-form-checkbox-text">
              Даю согласие на<a class="contact-form-checkbox-link"> обработку персональных данных</a>
            </span>
          </label>

          <Button className="open-form contact-form-submit">
            {buttonText}
          </Button>
        </form>
      </div>
    </div>

    <!-- WhatsApp блок: 3 колонки, 1 строка -->
    <div class="contact-method contact-method-whatsapp">
      <img src="/images/WP.svg" class="contact-method-icon" />
      <div class="contact-method-content">
        <h3 class="contact-method-title">Написать в WhatsApp</h3>
        <a href="tel:+78006000899" class="contact-method-link">+7 (800) 600-08-99</a>
      </div>
    </div>

    <!-- Telegram блок: 3 колонки, 1 строка -->
    <div class="contact-method contact-method-telegram">
      <img src="/images/Telegram.svg" class="contact-method-icon" />
      <div class="contact-method-content">
        <h3 class="contact-method-title">Написать в Telegram</h3>
        <a href="https://t.me/nexcorehub" class="contact-method-link">@nexcorehub</a>
      </div>
    </div>
  </div>
</section>

<style lang="scss" is:global>
.contact-form-section {
  width: 100%;
  max-width: var(--container-max);
  margin: 0 auto;
  padding: 2.5rem 1rem 5rem;
  position: relative;

  @media (min-width: 768px) {
    padding: 5rem 1rem 8rem;
  }
}

.contact-form-container {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 1.5rem;

  @media (max-width: 1023px) {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
}

.contact-form-main {
  grid-column: span 9 / span 9;
  grid-row: span 2 / span 2;
  position: relative;
  padding: 2rem 5rem;
  border-radius: 1.5rem;
  background-color: var(--color-light);
  overflow: hidden;

  @media (max-width: 1023px) {
    grid-column: 1 / -1;
    grid-row: auto;
    padding: 2rem 1rem;
  }
}

.contact-form-bg {
  position: absolute;
  bottom: 0;
  right: 0;
  

  img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
}

.contact-form-content {
  position: relative;
}

.contact-form-title {
  font-size: 1.875rem;
  font-weight: var(--font-bold);
  line-height: 1.25;
  color: var(--color-white);
  margin-bottom: 1rem;

  @media (min-width: 768px) {
    font-size: 2.25rem;
  }

  @media (min-width: 1024px) {
    font-size: 3rem;
  }
}

.contact-form {
  width: 100%;
}

.contact-form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
  margin-bottom: 1.5rem;

  @media (max-width: 767px) {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
}

.contact-form-field {
  display: flex;
  flex-direction: column;
  width: 100%;
  color: rgba(255, 255, 255, 0.7);

  &-textarea {
    margin-bottom: 1.5rem;
  }
}

.contact-form-label {
  margin-bottom: 0.5rem;
  font-size: 1.125rem;
}

.contact-form-input,
.contact-form-textarea {
  width: 100%;
  background-color: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(4px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 0.75rem;
  padding: 1rem 1.5rem;
  color: var(--color-white);
  font-size: 1.25rem;
  transition: border-color var(--transition-fast);

  &::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  &:focus {
    outline: none;
    border-color: rgba(255, 255, 255, 0.5);
  }
}

.contact-form-input {
  border-color: rgba(255, 255, 255, 0.2);
  
  &:focus {
    border-color: rgba(255, 255, 255, 0.5);
  }
}

.contact-form-textarea {
  resize: none;
}

.contact-form-checkbox {
  display: flex;
  align-items: flex-start;
  
  cursor: pointer;
}

.contact-form-checkbox-box {
  display: flex;
  align-items: center;
  height: 1.25rem;
  margin-top: 0.25rem;
}

.contact-form-checkbox-input {
  width: 1.25rem;
  height: 1.25rem;
  background-color: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(4px);
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 0.375rem;
  cursor: pointer;
  transition: all var(--transition-fast);
  appearance: none;
  -webkit-appearance: none;
  -moz-appearance: none;

  &:checked {
    background-color: rgba(255, 255, 255, 0.2);
    background-image: url("data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTYiIGhlaWdodD0iMTIiIHZpZXdCb3g9IjAgMCAxNiAxMiIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHBhdGggZD0iTTE0LjUgMkw2IDkuNUwxLjUgNSIgc3Ryb2tlPSJ3aGl0ZSIgc3Ryb2tlLXdpZHRoPSIyIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiLz4KPC9zdmc+Cg==");
    background-position: center;
    background-repeat: no-repeat;
  }

  &:focus {
    outline: none;
    border-color: rgba(255, 255, 255, 0.5);
  }
}

.contact-form-checkbox-text {
  margin-left: 1rem;
  margin-top: 0.25rem;
  color: rgba(255, 255, 255, 0.7);
  font-size: 1rem;
  line-height: 1.25;
}

.contact-form-checkbox-link {
  color: var(--color-accent);
  text-decoration: none;
}

.contact-form-submit {
  margin-top: 1.5rem;
}

.contact-method {
  grid-column: span 3 / span 3;
  border-radius: 1.5rem;
  background-color: var(--color-light);
  padding: 2rem;
  display: flex;
  flex-direction: column;

  @media (max-width: 1023px) {
    grid-column: 1 / -1;
    grid-row: auto;
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
  }

  @media (max-width: 639px) {
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }
}

.contact-method-content {
  margin-top: auto;
}

.contact-method-icon {
  width: 4rem;
  height: 4rem;

  @media (max-width: 1023px) {
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
  }
}

.contact-method-title {
  margin-top: auto;
  margin-bottom: 0.5rem;
  font-size: 1.125rem;
  font-weight: var(--font-medium);
  color: var(--color-white);

  @media (max-width: 1023px) {
    margin-top: 0;
    margin-bottom: 0.25rem;
    flex: 1;
  }
}

.contact-method-link {
  font-size: 1.5rem;
  color: var(--color-white);
  text-decoration: underline;
  transition: color var(--transition-fast);

  &:hover {
    color: var(--color-accent);
  }

  @media (max-width: 1023px) {
    font-size: 1.25rem;
  }
}

@media (max-width: 1023px) {
  .contact-method-whatsapp {
    grid-row: 2;
  }

  .contact-method-telegram {
    grid-row: 3;
  }
}
</style>