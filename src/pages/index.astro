---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Team from '../components/Team.astro';
import Result from '../components/Result.astro';
import Steps from '../components/Steps.astro';
import FAQ from '../components/FAQ.astro';
import BusinessSectors from '../components/BusinessSectors.astro';
import Footer from '../components/Footer.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Dashboard from '../components/Dashboard.astro';
import BusinessPartner from '../components/BusinessPartner.astro';
import Auto from '../components/Auto.astro';
import AutoMobile from '../components/AutoMobile.astro';
import Reasons from '../components/Reasons.astro';
import Carousel from '../components/Carousel.astro';
import Banner from '../components/Banner.astro';
import FormModal from '../components/FormModal.astro';
import OurSolutions from '../components/OurSolutions.astro';
import Cases from '../components/Cases.astro';
import Contact from '../components/Contact.astro';
import Modal from '../components/UI/Modal.astro';
import Form from '../components/Form.astro';
import Tools from '../components/Tools.astro';
import Review from '../components/Review.astro';
//  Контент 
import PrivacyPolicy from '../content/privacy-policy.md';

const itemsReview = [
  {
    name: "Максим С.",
